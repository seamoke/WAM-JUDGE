# Copy this file to code/.local/robotwin_stage2_rft.env on the training host.
STAGE2_DATA_ROOT=/path/to/prepared-dataset/stage2
# Needed once to restore the selected Stage-2 actions. It may be omitted when
# split_manifest.json still points to a valid original dataset on this host.
ORIGINAL_ROBOTWIN_ROOT=/path/to/robotwin-clean-and-aug-lerobot
# Generated automatically when absent. Use REAL_DATA_LINK_MODE=copy when this
# directory itself will be moved to another machine.
REAL_DATA_ROOT=/path/to/prepared-dataset/action_visible_real
REAL_DATA_LINK_MODE=hardlink
WAM_MODEL=/path/to/checkpoint_step_15000
VLAC_MODEL=/path/to/vlac-checkpoint
BASE_MODEL=/path/to/lingbot-va-base
OUTPUT_ROOT=/path/to/stage2-rft-output

# Set this only when resuming an existing online RFT state outside OUTPUT_ROOT.
# ONLINE_ROOT=/path/to/existing-online-rft-state

GPU_IDS=0,1,2,3,4,5,6,7
BUFFER_CAPACITY=1024
Q_PER_ROUND=320
CANDIDATES_PER_Q=8
MAX_PSEUDO_PER_CONTEXT=4
TRAIN_BATCH_SIZE_PER_GPU=32
TRAIN_GLOBAL_BATCH=256
REAL_FRACTION=0.7
REAL_DATA_MODE=stage1-stage2-visible
MAX_UPDATES=1000
MODEL_SAVE_EVERY_UPDATES=25

SWANLAB_PROJECT=lingbot-va-robotwin
SWANLAB_GROUP=robotwin-stage1-real-stage2-pseudo
SWANLAB_NAME=robotwin-stage2-online-dual-rft
